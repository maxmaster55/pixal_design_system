# Glowgrid pixel cursor theme. The art is generated by build.py (text grids
# -> PNGs, standard library only) and packed with xcursorgen.
#
#   pkgs.callPackage ./glowgrid/cursor { }
#
# Installs share/icons/Glowgrid/{index.theme,cursors/}; theme name "Glowgrid".
{
  lib,
  stdenvNoCC,
  python3,
  xcursorgen,
}:

stdenvNoCC.mkDerivation {
  pname = "glowgrid-cursors";
  version = "1.0";

  src = lib.fileset.toSource {
    root = ./.;
    fileset = ./build.py;
  };

  nativeBuildInputs = [
    python3
    xcursorgen
  ];

  dontConfigure = true;
  dontBuild = true;

  installPhase = ''
    runHook preInstall
    python3 -B build.py --out "$out/share/icons/Glowgrid"
    runHook postInstall
  '';

  meta = {
    description = "Glowgrid pixel-art X cursor theme";
    platforms = lib.platforms.linux;
  };
}
