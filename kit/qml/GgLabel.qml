// Silkscreen label: upper case, letter-spaced. For tabs, tags, headings, buttons.
import QtQuick

Text {
    font.family: Glowgrid.label
    font.pixelSize: 12
    font.letterSpacing: 1.6
    font.capitalization: Font.AllUppercase
    color: Glowgrid.textSoft
    verticalAlignment: Text.AlignVCenter
}
