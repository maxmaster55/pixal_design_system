{
  "name": "glowgrid",
  "description": "Pixel art lit from within. Semantic tokens; each theme overrides the light colors.",
  "color": {
    "bg":           { "value": "#0B0714", "role": "Deepest background, screen ground" },
    "surface":      { "value": "#170D24", "role": "Cards and panels on dark" },
    "stone":        { "value": "#3B2A3F", "role": "Mid tone, dividers on dark" },
    "stone-lit":    { "value": "#8A5A5A", "role": "Surfaces near a light" },
    "accent":       { "value": "#FF8A2A", "role": "Primary light: labels, markers", "emissive": true },
    "accent-hot":   { "value": "#FFD36B", "role": "Titles on dark, hottest pixels", "emissive": true },
    "accent-deep":  { "value": "#B24D0A", "role": "Accent on paper: tags, margin notes" },
    "title-shadow": { "value": "#3A1206", "role": "Hard drop shadow under display titles" },
    "glow-1":       { "value": "#7CF36B", "role": "Secondary light: pools, terminal text, success", "emissive": true },
    "glow-2":       { "value": "#E94BD6", "role": "Focal object", "emissive": true },
    "glow-3":       { "value": "#4BC6E9", "role": "Cold counter-light: kickers, links on dark", "emissive": true },
    "ink":          { "value": "#1C1226", "role": "Text and code blocks on paper" }
  },
  "ramp": {
    "stone": ["#120A1A", "#1F1229", "#2C1A35", "#3B2A3F", "#5A3D52", "#8A5A5A", "#C4825F"],
    "air":   ["#0B0714", "#100A1B", "#150C22", "#1B1029", "#241433", "#2F1A44"]
  },
  "paper": { "page": "#FFFFFF", "tint-accent": "#FFF1E4", "tint": "#F4EFF6", "rule": "#D9D0DE", "ink-soft": "#5B4A63" },
  "font": {
    "display": "Pixelify Sans", "label": "Silkscreen", "code": "VT323", "body": "IBM Plex Sans",
    "googleFontsCss": "https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@400;600;700&family=Silkscreen&family=VT323&family=IBM+Plex+Sans:ital,wght@0,400;0,600;1,400&display=swap"
  },
  "themes": {
    "ember": {
      "scene": "Dark cavern, binary embers, magenta crystal, acid pool",
      "css": "themes/ember.css", "js": "core/glowgrid.js (built in)",
      "color": { "accent": "#FF8A2A", "accent-hot": "#FFD36B", "accent-deep": "#B24D0A", "glow-1": "#7CF36B", "glow-2": "#E94BD6", "glow-3": "#4BC6E9", "tint-accent": "#FFF1E4" },
      "seeds": { "reference-cover": 1337 }
    },
    "forge": {
      "scene": "Cave forge: glowing cog over an anvil, molten pool, frost shards",
      "css": "themes/forge.css", "js": "themes/forge.js",
      "color": { "accent": "#FF9A3C", "accent-hot": "#FFC56A", "accent-deep": "#C25A12", "glow-1": "#FFE08A", "glow-2": "#F07A22", "glow-3": "#BDF0FF", "tint-accent": "#FFF0E0" },
      "seeds": { "cover": 1515, "back": 2024 }
    },
    "frost": {
      "scene": "Ice cavern: six-armed frost lattice, icicles, frozen pool, warm embers",
      "css": "themes/frost.css", "js": "themes/frost.js",
      "color": { "accent": "#4BC6E9", "accent-hot": "#BDF0FF", "accent-deep": "#17607A", "title-shadow": "#0B2A3A", "glow-1": "#8FE3F7", "glow-2": "#E6FBFF", "glow-3": "#FFD36B", "tint-accent": "#EEF7FB" },
      "seeds": { "cover": 2605, "back": 1103, "band": 13 }
    },
    "geode": {
      "scene": "Geode cavern: one isometric crystal cube with a lit memory grid, violet crystal spikes, a pool of violet light, warm hex-digit sparks",
      "css": "themes/geode.css", "js": "themes/geode.js",
      "color": { "accent": "#9B7BFF", "accent-hot": "#D9CCFF", "accent-deep": "#4F35C2", "title-shadow": "#1D0F4A", "glow-1": "#B9A6FF", "glow-2": "#EFE9FF", "glow-3": "#FFD36B", "tint-accent": "#F1EDFF" },
      "seeds": { "cover": 3141, "back": 2017 }
    }
  }
}
