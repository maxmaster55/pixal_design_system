  "ui": {
    "description": "Tokens for screen interfaces (bars, panels, apps). Shared by every theme.",
    "color": {
      "text": {
        "value": "#E9DEF0",
        "role": "Running text and values on dark"
      },
      "text-soft": {
        "value": "#A493B0",
        "role": "Secondary text, labels at rest, unlit icons"
      },
      "alert": {
        "value": "#FF5F5F",
        "role": "Errors and destructive states. The only red.",
        "emissive": true
      },
      "air-3": {
        "value": "#1B1029",
        "role": "Raised strip inside a panel: headers, sidebars"
      },
      "air-5": {
        "value": "#2F1A44",
        "role": "Pressed or selected background that is not a light"
      },
      "black": {
        "value": "#000000",
        "role": "Hard shadows and the 2px edge under bars and headers"
      }
    },
    "size": {
      "grid": {
        "value": 2,
        "unit": "px",
        "role": "Everything aligns to 2px; spacing uses multiples of it"
      },
      "border": {
        "value": 1,
        "unit": "px",
        "role": "Resting outline of rows and inputs, in stone"
      },
      "border-focus": {
        "value": 2,
        "unit": "px",
        "role": "Hover, selection and focus outline, in the accent"
      },
      "edge": {
        "value": 2,
        "unit": "px",
        "role": "Black line under bars, headers and tab strips"
      },
      "ring": {
        "value": 3,
        "unit": "px",
        "role": "Focus ring around the focused window"
      },
      "shadow-sm": {
        "value": 3,
        "unit": "px",
        "role": "Hard offset shadow of icon buttons"
      },
      "shadow-md": {
        "value": 4,
        "unit": "px",
        "role": "Hard offset shadow of text buttons"
      },
      "shadow-lg": {
        "value": 8,
        "unit": "px",
        "role": "Hard offset shadow of panels, cards and windows"
      },
      "radius": {
        "value": 0,
        "unit": "px",
        "role": "Always zero"
      },
      "bar-height": {
        "value": 44,
        "unit": "px",
        "role": "Top bar"
      },
      "row-pad": {
        "value": "9px 10px",
        "role": "Padding of a list row"
      },
      "panel-pad": {
        "value": 12,
        "unit": "px",
        "role": "Padding inside a panel page"
      },
      "gap": {
        "value": 8,
        "unit": "px",
        "role": "Gap between stacked rows"
      },
      "icon-cell": {
        "value": 2,
        "unit": "px",
        "role": "Screen pixels per art pixel of a 7x7 icon (14px icon)"
      }
    },
    "type": {
      "label": {
        "family": "Silkscreen",
        "size": "10-12px",
        "tracking": "0.12-0.16em",
        "case": "upper",
        "use": "Labels, tabs, tags, group headings, buttons"
      },
      "value": {
        "family": "VT323",
        "size": "17-19px",
        "use": "Numbers, addresses, clocks, counts, terminal text"
      },
      "body": {
        "family": "IBM Plex Sans",
        "size": "12.5-15px",
        "weight": "400/600",
        "use": "Names, descriptions, any sentence"
      },
      "display": {
        "family": "Pixelify Sans",
        "size": "20-28px in UI",
        "weight": "600/700",
        "use": "One headline per surface: a state, a title"
      }
    },
    "motion": {
      "press": {
        "ms": 80,
        "steps": 2,
        "use": "Hover and press feedback, colour changes"
      },
      "toggle": {
        "ms": 120,
        "steps": 3,
        "use": "Switches, progress cells"
      },
      "move": {
        "ms": 180,
        "use": "Panels opening, tabs sliding, list rows rising (5 steps)"
      },
      "reassemble": {
        "ms": "220-300",
        "use": "Windows assembling from cells"
      },
      "art-fps": {
        "value": 12,
        "use": "Pixel-art animation and spinners: held frames, no tweening"
      },
      "breathe": {
        "ms": 1400,
        "steps": 2,
        "use": "A lit status cell alternating between two brightness levels"
      },
      "springs": {
        "gentle": [
          140,
          1.0
        ],
        "default": [
          300,
          0.8
        ],
        "fast": [
          500,
          0.85
        ],
        "expressive": [
          220,
          0.65
        ],
        "use": "[stiffness, damping ratio] for spatial movement where the platform has springs"
      }
